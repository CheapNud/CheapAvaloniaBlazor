<!-- Build/CheapAvaloniaBlazor.targets -->
<Project>
  <Target Name="CheapAvaloniaBlazorCheck" BeforeTargets="Build">
    <Message Text="CheapAvaloniaBlazor: Configuring Blazor desktop application..." Importance="high" />
  </Target>

  <!--
    Put blazor.web.js in the app's wwwroot/_framework/.

    Blazor Web App cannot boot without it, and nothing in the SDK will place it for us: the
    Microsoft.AspNetCore.App.Internal.Assets targets register it as a static web asset only when
    UsingMicrosoftNETSdkWeb is true AND OutputType is exactly "Exe". Desktop apps are Sdk.Razor
    with OutputType=WinExe, so both gates fail and the script is silently absent — the app runs,
    serves its HTML, and renders a blank white window.

    This runs as Content with CopyToOutputDirectory, NOT as a plain Copy task, because a Copy into
    $(OutputPath) is invisible to `dotnet publish`. That was the bug: dev machines papered over it
    with the runtime NuGet-cache extractor, and only a clean end-user machine showed the white
    screen. Content items are carried into the publish directory by the SDK.

    $(BlazorFrameworkStaticWebAssetRoot) is defined by the Internal.Assets package itself, which
    CheapAvaloniaBlazor references non-privately so every consumer restores it. One scalar path,
    no globbing: this file is only ever imported through a PackageReference, so the package is
    always in that project's graph. If it somehow is not, the app still works — CheapAvaloniaBlazor
    extracts the script at startup, and failing that serves the copy embedded in its assembly.
  -->
  <Target Name="CopyBlazorFrameworkFilesFromLibrary"
          BeforeTargets="AssignTargetPaths"
          Condition="'$(TargetFramework)' != '' AND $([MSBuild]::VersionGreaterThanOrEquals('$(TargetFrameworkVersion)', '10.0'))">
    <PropertyGroup>
      <_CheapBlazorWebJsSource Condition="'$(BlazorFrameworkStaticWebAssetRoot)' != '' AND Exists('$(BlazorFrameworkStaticWebAssetRoot)\blazor.web.js')">$(BlazorFrameworkStaticWebAssetRoot)\blazor.web.js</_CheapBlazorWebJsSource>
    </PropertyGroup>

    <ItemGroup Condition="'$(_CheapBlazorWebJsSource)' != ''">
      <!-- Skip when the project really is a Web SDK Exe: there the SDK already registered the
           script as a static web asset and a second copy would collide. -->
      <Content Include="$(_CheapBlazorWebJsSource)"
               Condition="!('$(UsingMicrosoftNETSdkWeb)' == 'true' AND '$(OutputType)' == 'Exe')">
        <Link>wwwroot\_framework\blazor.web.js</Link>
        <TargetPath>wwwroot\_framework\blazor.web.js</TargetPath>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <Pack>false</Pack>
      </Content>
    </ItemGroup>

    <Message Text="CheapAvaloniaBlazor: blazor.web.js -&gt; wwwroot/_framework/ (source: $(_CheapBlazorWebJsSource))"
             Importance="normal" Condition="'$(_CheapBlazorWebJsSource)' != ''" />
    <Message Text="CheapAvaloniaBlazor: Microsoft.AspNetCore.App.Internal.Assets is not in this project's package graph; the app will extract or serve its embedded blazor.web.js at runtime."
             Importance="normal" Condition="'$(_CheapBlazorWebJsSource)' == ''" />
  </Target>

  <!-- Only create wwwroot if it doesn't exist, no copying -->
  <Target Name="EnsureWwwrootExists" BeforeTargets="Build" Condition="!Exists('$(MSBuildProjectDirectory)\wwwroot')">
    <PropertyGroup>
      <WwwRootPath>$(MSBuildProjectDirectory)\wwwroot</WwwRootPath>
    </PropertyGroup>

    <MakeDir Directories="$(WwwRootPath)" />

    <!-- Create minimal favicon to prevent 404s -->
    <WriteLinesToFile
      File="$(WwwRootPath)\favicon.ico"
      Lines=""
      Overwrite="false" />

    <Message Text="CheapAvaloniaBlazor: Created minimal wwwroot folder" Importance="normal" />
  </Target>

  <!-- Import Razor SDK targets if not already imported -->
  <Import Project="$(MSBuildExtensionsPath)\Microsoft\Microsoft.NET.Sdk.Razor\build\netstandard2.0\Microsoft.NET.Sdk.Razor.targets"
          Condition="'$(UsingMicrosoftNETSdkRazor)' != 'true' and Exists('$(MSBuildExtensionsPath)\Microsoft\Microsoft.NET.Sdk.Razor\build\netstandard2.0\Microsoft.NET.Sdk.Razor.targets')" />
</Project>
