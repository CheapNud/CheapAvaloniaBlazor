<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Package Information -->
    <PackageId>CheapAvaloniaBlazor</PackageId>
    <Version>4.0.0</Version>
    <Authors>CheapNud</Authors>
    <Company>CheapLudes</Company>
    <Description>Stable Blazor desktop framework with professional splash screen, static-web-asset JavaScript bridge, and clean file management</Description>
    <PackageProjectUrl>https://github.com/CheapNud/CheapAvaloniaBlazor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/CheapNud/CheapAvaloniaBlazor</RepositoryUrl>
    <PackageTags>blazor;avalonia;photino;desktop;mudblazor;cross-platform;webview;splash-screen</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Version 4.0.0 - Targets .NET 11 only, with CheapHelpers 4.0, Avalonia 12.1.4 and MudBlazor 9.11. Follows the .NET 11 Internal.Assets package layout (staticwebassets/_framework) for the build-time, startup and embedded copies of blazor.web.js. Previous release: 3.4.1 fixed a blank white window on machines that never had the .NET SDK.</PackageReleaseNotes>

    <!-- Build Configuration -->
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RootNamespace>CheapAvaloniaBlazor</RootNamespace>
    <AssemblyName>CheapAvaloniaBlazor</AssemblyName>

    <!-- Enable Razor support -->
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <EnableDefaultRazorComponentItems>true</EnableDefaultRazorComponentItems>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude samples, templates and tests folders from library compilation -->
    <Compile Remove="samples\**;templates\**;CheapAvaloniaBlazor.Tests\**" />
    <!-- These are repo-local dev files; packing them leaked our test-runner pin into consumers -->
    <None Remove="global.json;Properties\launchSettings.json" />
    <Content Remove="global.json;Properties\launchSettings.json" />
    <Content Remove="samples\**;templates\**;CheapAvaloniaBlazor.Tests\**" />
    <EmbeddedResource Remove="samples\**;templates\**;CheapAvaloniaBlazor.Tests\**" />
    <None Remove="samples\**;templates\**;CheapAvaloniaBlazor.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Core Dependencies -->
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="MudBlazor" Version="9.11.0" />
    <PackageReference Include="Photino.NET" Version="4.0.16" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.1" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <!-- Framework Reference for Blazor Server (provides Components.Web, Hosting, FileProviders) -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />

    <!-- Shared settings service (ISettingsService, FileSettingsService) -->
    <PackageReference Include="CheapHelpers" Version="4.0.0" />

    <!-- Ships blazor.web.js. NOT PrivateAssets: consumers must restore it too, so
         Build/CheapAvaloniaBlazor.targets can resolve $(BlazorFrameworkStaticWebAssetRoot)
         from their own package graph instead of scraping the machine-global NuGet cache. -->
    <PackageReference Include="Microsoft.AspNetCore.App.Internal.Assets" Version="11.0.0-rc.2.26504.105" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- Last-resort copy of blazor.web.js baked into the library assembly. Every other layer
         (static web asset at publish time, NuGet cache extraction at startup) depends on files
         that a clean end-user machine may simply not have; the DLL always ships with the app.
         See Utilities/BlazorFrameworkExtractor for the layer order. -->
    <!-- .NET 11 moved the package payload from _framework/ to staticwebassets/_framework/. -->
    <EmbeddedResource Include="$(PkgMicrosoft_AspNetCore_App_Internal_Assets)\staticwebassets\_framework\blazor.web.js"
                      LogicalName="CheapAvaloniaBlazor.Embedded.blazor.web.js" />

    <!-- Same treatment for our own JS bridge. It normally serves as a static web asset at
         _content/CheapAvaloniaBlazor/, but that chain has several ways to break on a machine
         we do not control, and when it breaks MapStaticAssets throws FileNotFoundException
         rather than 404ing. 5 KB is cheap insurance for the file that carries every desktop
         interop call. This is also a Content item via the SDK's wwwroot glob — both copies
         are intentional. -->
    <EmbeddedResource Include="wwwroot\cheap-blazor-interop.js"
                      LogicalName="CheapAvaloniaBlazor.Embedded.cheap-blazor-interop.js" />
  </ItemGroup>

  <!-- An empty $(Pkg...) property would include nothing and quietly ship a package whose
       last-resort layer does not exist — the exact silent failure this whole arrangement is
       here to prevent. Fail the build instead. -->
  <Target Name="EnsureBlazorWebJsIsEmbedded" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(PkgMicrosoft_AspNetCore_App_Internal_Assets)\staticwebassets\_framework\blazor.web.js')"
           Text="blazor.web.js was not found under '$(PkgMicrosoft_AspNetCore_App_Internal_Assets)'. Microsoft.AspNetCore.App.Internal.Assets must be restored with GeneratePathProperty=&quot;true&quot; or the embedded fallback ships empty. Run 'dotnet restore'." />
  </Target>

  <ItemGroup>
    <!-- Package Assets -->
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CheapAvaloniaBlazor.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build targets for consuming projects -->
    <Content Include="Build\CheapAvaloniaBlazor.props" PackagePath="build" />
    <Content Include="Build\CheapAvaloniaBlazor.targets" PackagePath="build" />
  </ItemGroup>
</Project>